###################
## Power Domains ##
###################
create_power_domain PD_MEMORY_ISLAND \
  -elements {.} \
  -supply {primary}



if {$WIDE_BANKE_INTERLEAVD == 1} {
    set banks_per_dom [expr $PHYS_BANKS/$PWR_DOMAINS]

    for {set nd 0} {$nd < $PWR_DOMAINS} {incr nd} {
        set element_list ""

        set start_bank [expr $nd*$banks_per_dom]

        for {set wb 0} {$wb < $WIDE_BANKS} {incr wb} {
            for {set nb 0} {$nb < $NAR_BANKS} {incr nb} {
                for {set pb 0} {$pb < $banks_per_dom} {incr pb} {

                    set actual_bank [expr $start_bank+$pb]
                    append element_list "i_memory_island/gen_wide_banks[$wb]/gen_narrow_banks[$nb]/i_bank/gen_logic_bank/gen_logic_bank[$actual_bank]/i_tc_sram_impl "

                }
            }
        }

        create_power_domain "PD_TC_SRAM_${nd}" \
        -elements $element_list \
        -supply {primary}
    }
} else {
    set phys_bank_counter 0
    set current_domain 0
    set banks_per_dom [expr ($WIDE_BANKS * $NAR_BANKS * $PHYS_BANKS)/$PWR_DOMAINS]
    set element_list ""

    for {set wb 0} {$wb < $WIDE_BANKS} {incr wb} {
        for {set pb 0} {$pb < $PHYS_BANKS} {incr pb} {
            for {set nb 0} {$nb < $NAR_BANKS} {incr nb} {

                append element_list "i_memory_island/gen_wide_banks[$wb]/gen_narrow_banks[$nb]/i_bank/gen_logic_bank/gen_logic_bank[$pb]/i_tc_sram_impl "

                incr phys_bank_counter

                if {$phys_bank_counter >= $banks_per_dom} {

                    create_power_domain "PD_TC_SRAM_${current_domain}" \
                        -elements $element_list \
                        -supply {primary}
                    
                    set phys_bank_counter 0
                    incr current_domain
                    set element_list ""
                }

            }
        }
    }
}


###############
## Load UPFs ##
###############




##################
## Power States ##
##################
add_power_state -domain PD_MEMORY_ISLAND \
  -state {ON   -logic_expr { PD_MEMORY_ISLAND.primary==ON  }}

for {set nd 0} {$nd < $PWR_DOMAINS} {incr nd} {

    add_power_state PD_TC_SRAM_${nd} \
    -state [list ON    -logic_expr [format {PD_TC_SRAM_%s.primary == ON } $nd]] \
    -state [list RET   -logic_expr [format {PD_TC_SRAM_%s.primary == RET} $nd]] \
    -state [list OFF   -logic_expr [format {PD_TC_SRAM_%s.primary == OFF} $nd]]
}
