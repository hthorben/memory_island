################
## LOGIC NETS ##
################

for {set nd 0} {$nd < $PWR_DOMAINS} {incr nd} {
            
    create_logic_port domain_${nd}_powergate

    create_logic_net domain_${nd}_powergate

    connect_logic_net domain_${nd}_powergate -reconnect \
    -ports "impl_i[$nd].powergate domain_${nd}_powergate"


}


#################
## Power State ##
#################

for {set nd 0} {$nd < $PWR_DOMAINS} {incr nd} {

    add_power_state -domain PD_TC_SRAM_${nd} -update \
    -state {ON    -logic_expr {  !"domain_${nd}_powergate" }} \
    -state {OFF   -logic_expr {   "domain_${nd}_powergate" }} 

}