################
## LOGIC NETS ##
################

for {set nd 0} {$nd < $PWR_DOMAINS} {incr nd} {

    create_logic_net "domain_${nd}_powergate"
    create_logic_net "domain_${nd}_deepsleep"

    connect_logic_net "domain_${nd}_powergate" \
    -ports "upf_signals[0][${nd}]"

    connect_logic_net "domain_${nd}_deepsleep" \
    -ports "upf_signals[1][${nd}]"

}


#################
## Power State ##
#################

for {set nd 0} {$nd < $PWR_DOMAINS} {incr nd} {
    set on_expr  "(!domain_${nd}_powergate) & (!domain_${nd}_deepsleep)"
    set sleep_expr  "(!domain_${nd}_powergate) & domain_${nd}_deepsleep"
    set off_expr "domain_${nd}_powergate"

    add_power_state -domain PD_TC_SRAM_${nd} -update \
        -state "ON    -logic_expr {$on_expr}" \
        -state "RET   -logic_expr {$sleep_expr}" \
        -state "OFF   -logic_expr {$off_expr}"
}
